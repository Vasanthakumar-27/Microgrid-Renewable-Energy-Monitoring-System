# ================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ================================================================

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/microgrid
DB_URI=mongodb://127.0.0.1:27017/microgrid
DB_NAME=microgrid

# Server Configuration
PORT=5000
NODE_ENV=development
HOST=127.0.0.1

# Security & Authentication
JWT_SECRET=your_256_bit_random_hex_string_for_jwt_secret_key_32_bytes
ENCRYPTION_KEY=your_256_bit_random_hex_string_for_encryption_32_bytes
HMAC_SECRET=your_hmac_secret_for_webhook_signing

# HTTPS/TLS (Development - optional)
HTTPS_ENABLED=false
SSL_KEY_PATH=./certs/dev-key.pem
SSL_CERT_PATH=./certs/dev-cert.pem

# Alerts
ALERT_TTL_MS=180000
ALERT_DELETE_DELAY_MS=30000
ALERT_GENERATE_INTERVAL_MS=20000
ALERT_MAX_OPEN=40

# Schedulers
REMINDER_SWEEP_MS=86400000
BILL_SWEEP_MS=43200000

# Tariff Rates (INR/kWh)
TARIFF_MIN=1
TARIFF_MAX=100

# Phase 2A: Email/SMS Service
# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=billing@microgrid-system.com

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE=+1234567890

# Redis (for Bull Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Notifications
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true

# Phase 2B: Payment Gateway
# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
ENABLE_RAZORPAY=true

# Phase 2C: File Upload
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf
